{
  "name": "dsh-opencode-live",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode as a DSH subagent, with a live trace panel for its agent, tools, and self-spawned subagents.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "web/*.html",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
